  "description": "Shows agents as a tree of machines, projects, agents and subagents in the Paseo sidebar.",
  "license": "MIT",
  "author": "Louis Moret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louisssmrt/paseo-agent-tree.git"
  },
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "OVERVIEW.*.md",
